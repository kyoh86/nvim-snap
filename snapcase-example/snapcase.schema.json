{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "snapcase.schema.json",
  "title": "snapcase-example",
  "type": "object",
  "properties": {
    "scenario": {
      "type": "string",
      "description": "scenario.luaへの相対パスまたは絶対パス"
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "description": "UIの列数"
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "description": "UIの行数"
    },
    "data_home": {
      "type": "string",
      "description": "XDG_DATA_HOMEの相対/絶対パス"
    },
    "config_home": {
      "type": "string",
      "description": "XDG_CONFIG_HOMEの相対/絶対パス"
    },
    "out_dir": {
      "type": "string",
      "description": "出力先ディレクトリ"
    },
    "outputs": {
      "type": "object",
      "properties": {
        "json": {
          "$ref": "#/definitions/outputPath"
        },
        "ansi": {
          "$ref": "#/definitions/outputPath"
        },
        "html": {
          "$ref": "#/definitions/outputPath"
        }
      },
      "additionalProperties": false,
      "description": "出力ファイル名/出力設定"
    }
  },
  "patternProperties": {
    "^\\$schema$": {
      "type": "string",
      "description": "JSON Schemaへの参照"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "outputPath": {
      "description": "出力ファイル名または'-'、無効化は'none'またはfalse",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean",
          "const": false
        }
      ]
    }
  }
}
