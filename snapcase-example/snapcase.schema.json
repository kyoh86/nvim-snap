{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "snapcase.schema.json",
  "title": "nvim-snap case definition",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "snapcase.jsonのバージョン"
    },
    "title": {
      "type": "string",
      "description": "表示名（省略時はケース名）"
    },
    "kind": {
      "type": "string",
      "enum": [
        "regression",
        "golden"
      ],
      "description": "テスト種別（ディレクトリ名と一致させる）"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "タグの配列"
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "description": "UI columns"
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "description": "UI lines"
    },
    "wait": {
      "type": "integer",
      "minimum": 1,
      "description": "Wait for redraw flush (ms)"
    },
    "post_wait": {
      "type": "integer",
      "minimum": 1,
      "description": "Wait after scenario execution (ms)"
    },
    "wait_done": {
      "type": "boolean",
      "description": "Wait for scenario completion notification"
    },
    "done_timeout": {
      "type": "integer",
      "minimum": 1,
      "description": "Wait timeout for scenario completion (ms)"
    },
    "rpc_timeout": {
      "type": "integer",
      "minimum": 1,
      "description": "RPC timeout (ms)"
    },
    "log_file": {
      "type": "string",
      "description": "Neovim log file path (NVIM_LOG_FILE)"
    },
    "log_level": {
      "type": "string",
      "description": "Neovim log level (NVIM_LOG_LEVEL)"
    },
    "data_home": {
      "type": "string",
      "description": "XDG data home (default: .nvim-data)"
    },
    "config_home": {
      "type": "string",
      "description": "XDG config home (default: .nvim-config)"
    },
    "rtp": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ],
      "description": "Runtimepath entries to prepend. ${CASE} and ${ROOT} placeholders are supported."
    }
  },
  "required": [
    "version",
    "kind"
  ],
  "additionalProperties": false
}
