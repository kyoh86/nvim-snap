{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "nvim-snap case definition",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version (currently 1)"
    },
    "title": {
      "type": "string",
      "description": "Display name (default: case directory name)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of tags"
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "description": "UI columns"
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "description": "UI lines"
    },
    "wait": {
      "type": "integer",
      "minimum": 1,
      "description": "Wait for redraw flush (ms)"
    },
    "post_wait": {
      "type": "integer",
      "minimum": 1,
      "description": "Wait after scenario execution (ms)"
    },
    "wait_done": {
      "type": "boolean",
      "description": "Wait for scenario completion notification"
    },
    "done_timeout": {
      "type": "integer",
      "minimum": 1,
      "description": "Wait timeout for scenario completion (ms)"
    },
    "rpc_timeout": {
      "type": "integer",
      "minimum": 1,
      "description": "RPC timeout (ms). When wait_done is enabled, this is bumped above done_timeout."
    },
    "log_file": {
      "type": "string",
      "description": "Neovim log file path (NVIM_LOG_FILE). Relative paths are resolved from the case directory."
    },
    "log_level": {
      "type": "string",
      "description": "Neovim log level (NVIM_LOG_LEVEL)"
    },
    "data_home": {
      "type": "string",
      "description": "XDG data home (default: .nvim-data). Relative paths are resolved from the case directory."
    },
    "config_home": {
      "type": "string",
      "description": "XDG config home (default: .nvim-config). Relative paths are resolved from the case directory."
    },
    "rtp": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ],
      "description": "Runtimepath entries to prepend. ${CASE} and ${ROOT} placeholders are supported."
    }
  },
  "required": [
    "version"
  ],
  "additionalProperties": false
}
